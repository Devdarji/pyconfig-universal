# Example .env file for PyConfig Universal

# Application settings
ENVIRONMENT=development
DEBUG=true

# Server configuration
SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__WORKERS=4

# Database configuration
DATABASE__URL=postgresql://user:password@localhost:5432/myapp
DATABASE__POOL_SIZE=20
DATABASE__TIMEOUT=45s

# API configuration
API__KEY=your-secret-api-key-here-32-chars-min
API__TIMEOUT=30s
API__RATE_LIMIT=5000

# Feature flags (comma-separated)
FEATURES=authentication,caching,monitoring

# Email configuration
EMAIL__SMTP_HOST=smtp.gmail.com
EMAIL__SMTP_PORT=587
EMAIL__USERNAME=your-email@gmail.com
EMAIL__PASSWORD=your-app-password
EMAIL__FROM_EMAIL=noreply@yourapp.com

# Logging configuration
LOGGING__LEVEL=INFO
LOGGING__FILE=/var/log/myapp.log
LOGGING__MAX_SIZE=50MB
LOGGING__BACKUP_COUNT=10

# Cache configuration
CACHE__BACKEND=redis
CACHE__URL=redis://localhost:6379/0
CACHE__TTL=2h
CACHE__MAX_ENTRIES=10000

# Security settings
SECURITY__SECRET_KEY=your-super-secret-key-change-this-in-production
SECURITY__ALLOWED_HOSTS=localhost,127.0.0.1,yourapp.com
SECURITY__CORS_ORIGINS=http://localhost:3000,https://yourapp.com
SECURITY__SESSION_TIMEOUT=12h
